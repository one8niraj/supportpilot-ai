# Copy this file to ".env" and fill in your own values. Never commit ".env".
# Get a key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-api-key-here

# Optional. Must be a Gemini model that supports JSON/structured output.
# SUPPORTPILOT_MODEL=gemini-3.8-flash

# Optional. Request timeout in seconds (1-120). Default: 30
# SUPPORTPILOT_TIMEOUT_SECONDS=30
